# Recorded API responses and test fixtures are byte-exact data (some are CRLF
# CSVs as the services return them): no line-ending conversion, no diffs as text.
docs/provider-apis/** -text
tests/fixtures/** -text
*.nc binary
packaging/licenses/** -text
# Files that tests compare byte for byte with generated output: LF on every
# checkout (Windows runners convert text to CRLF otherwise).
docs/schemas/** text eol=lf
*.qml text eol=lf
