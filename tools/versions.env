#
# Toolchain versions shared by the dev image (tools/dev/Dockerfile build args,
# passed by tools/dev/run.sh) and CI (.github/actions/load-versions). Plain
# KEY=value lines, no quotes: CI appends them to $GITHUB_ENV verbatim.
# The vcpkg baseline is not here: vcpkg-configuration.json is its only source.
# Anything still synced by hand is listed in tools/dev/README.md.
UBUNTU_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
GCC_VERSION=14
LLVM_VERSION=20
# Clang + libc++ at the version of Apple's toolchain (macOS CI): the dev-libcxx preset and
# its CI job. Apple Clang 16 (Xcode 16.x) corresponds to the libc++ of LLVM 17-18; see
# docs/wp-notes/portability.md.
LIBCXX_VERSION=18
CMAKE_VERSION=4.4.4
CMAKE_SHA256=e5bb807f7728cb60cd8b27ebc97a2edb469b68655f21e844a600c3575b76f5bb
QT_VERSION=6.11.3
# aqtinstall does not resolve dependencies between modules: qtquick3d is one of
# qtgraphs, and qttasktree one of the QML asset downloader plugin in qtdeclarative
# (without it, every find_package(Qt6 Qml) warns).
QT_MODULES=qtgraphs qtlocation qtpositioning qtquick3d qtshadertools qttasktree
