#
# Toolchain versions shared by the dev image (tools/dev/Dockerfile build args,
# passed by tools/dev/run.sh) and CI (.github/actions/load-versions). Plain
# KEY=value lines, no quotes: CI appends them to $GITHUB_ENV verbatim.
# The vcpkg baseline is not here: vcpkg-configuration.json is its only source.
# Anything still synced by hand is listed in tools/dev/README.md.
UBUNTU_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
GCC_VERSION=14
LLVM_VERSION=20
# Clang + libc++ at the version of Apple's toolchain (macOS CI): the dev-libcxx preset and
# its CI job. Apple Clang 16 (Xcode 16.x) corresponds to the libc++ of LLVM 17-18; see
# docs/wp-notes/portability.md.
LIBCXX_VERSION=18
CMAKE_VERSION=4.4.4
CMAKE_SHA256=e5bb807f7728cb60cd8b27ebc97a2edb469b68655f21e844a600c3575b76f5bb
QT_VERSION=6.11.3
# aqtinstall does not resolve dependencies between modules: qtquick3d is one of
# qtgraphs, and qttasktree one of the QML asset downloader plugin in qtdeclarative
# (without it, every find_package(Qt6 Qml) warns).
QT_MODULES=qtgraphs qtlocation qtpositioning qtquick3d qtshadertools qttasktree
# The AppImage is built on Ubuntu 22.04 (glibc 2.35, plan §6.24) with GCC_VERSION from
# the ubuntu-toolchain-r PPA: tools/dev/appimage/Dockerfile, MOV_DEV_IMAGE=appimage.
APPIMAGE_UBUNTU_IMAGE=ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401
# linuxdeploy and its Qt plugin (release tags; SHA-256 of the x86_64 AppImage), and the
# AppImage runtime (type2-runtime release tag; SHA-256 of runtime-x86_64), which would
# otherwise be the moving "continuous" build. The package-linux CPack step downloads and
# verifies them (packaging/linux/appimage.cmake).
LINUXDEPLOY_VERSION=1-alpha-20251107-1
LINUXDEPLOY_SHA256=c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d
LINUXDEPLOY_PLUGIN_QT_VERSION=1-alpha-20250213-1
LINUXDEPLOY_PLUGIN_QT_SHA256=15106be885c1c48a021198e7e1e9a48ce9d02a86dd0a1848f00bdbf3c1c92724
LINUXDEPLOY_APPIMAGE_RUNTIME_VERSION=20251108
LINUXDEPLOY_APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
