#
# AppRun hook of the MetOceanViewer AppImage; linuxdeploy's AppRun sources it
# (under `set -e`) before it starts the application. Configured by
# packaging/linux/appimage.cmake.
#
# The AppImage is built on Ubuntu 22.04 with a newer GCC than 22.04's, so its
# binaries need these symbol versions of libstdc++:
#   @MOV_STDCXX_REQUIRED@
# It carries a libstdc++ (and libgcc_s) that has them in
# usr/optional/libstdc++/, and puts that directory first on the library path
# only when the system's libstdc++ lacks one of them. Never the other way
# round: a bundled copy older than the system's would break system libraries
# loaded into the process (Mesa's drivers) that need the newer one.

mov_stdcxx_system() {
  # The system's libstdc++.so.6: ldconfig's cache (ldconfig is not always on
  # PATH), else the usual locations.
  for mov_ldconfig in ldconfig /sbin/ldconfig /usr/sbin/ldconfig; do
    if command -v "${mov_ldconfig}" >/dev/null 2>&1; then
      mov_found="$("${mov_ldconfig}" -p 2>/dev/null |
        sed -n 's/^[[:space:]]*libstdc++\.so\.6 (libc6,x86-64[^)]*) => //p' | head -n 1 || true)"
      if [ -n "${mov_found}" ]; then
        printf '%s\n' "${mov_found}"
        return 0
      fi
    fi
  done
  for mov_found in /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /usr/lib64/libstdc++.so.6 \
    /lib64/libstdc++.so.6 /usr/lib/libstdc++.so.6; do
    if [ -e "${mov_found}" ]; then
      printf '%s\n' "${mov_found}"
      return 0
    fi
  done
  return 1
}

mov_stdcxx_lib="$(mov_stdcxx_system || true)"
mov_stdcxx_use_bundled=0
if [ -z "${mov_stdcxx_lib}" ] || [ ! -r "${mov_stdcxx_lib}" ]; then
  mov_stdcxx_use_bundled=1
else
  for mov_version in @MOV_STDCXX_REQUIRED@; do
    # -w: GLIBCXX_3.4.3 must not match inside GLIBCXX_3.4.33.
    if ! grep -qawF "${mov_version}" "${mov_stdcxx_lib}"; then
      mov_stdcxx_use_bundled=1
    fi
  done
fi
if [ "${mov_stdcxx_use_bundled}" = 1 ]; then
  # APPDIR is set by the AppImage runtime; this_dir by AppRun (an extracted
  # AppDir run directly).
  mov_appdir="${APPDIR:-${this_dir:-}}"
  export LD_LIBRARY_PATH="${mov_appdir}/usr/optional/libstdc++${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi
unset -f mov_stdcxx_system
unset mov_ldconfig mov_found mov_appdir mov_stdcxx_lib mov_stdcxx_use_bundled mov_version
