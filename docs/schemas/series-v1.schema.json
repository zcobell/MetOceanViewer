{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zcobell/MetOceanViewer/master/docs/schemas/series-v1.schema.json",
  "title": "Series JSON, format metoceanviewer-series 1.0",
  "description": "Normative structure of docs/series-json.md, version 1.x (this schema describes 1.0 in full; its version pattern accepts every 1.x). Rules the schema cannot express (a station's time axis and its series' arrays of equal length, times increasing, a status per sample consistent with its value) are in that document, section 5.",
  "type": "object",
  "required": [
    "format",
    "version",
    "stations"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "metoceanviewer-series"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]{0,8})$"
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/station"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "^[^\\u0000]*$"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "station": {
      "type": "object",
      "required": [
        "id",
        "name",
        "lon",
        "lat",
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "minLength": 1
            }
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "provider": {
          "enum": [
            "noaa_coops",
            "usgs",
            "ndbc",
            "harmonics",
            "adcirc",
            "dflowfm",
            "user"
          ],
          "$comment": "the station netCDF station_provider tokens (core DataSource)"
        },
        "lon": {
          "type": "number",
          "exclusiveMinimum": -180,
          "maximum": 180
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "time": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]{4,}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          }
        },
        "date": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]{4,}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/series"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "time"
          ],
          "not": {
            "required": [
              "date"
            ]
          },
          "properties": {
            "series": {
              "items": {
                "not": {
                  "required": [
                    "statistic"
                  ]
                }
              }
            }
          }
        },
        {
          "required": [
            "date"
          ],
          "not": {
            "required": [
              "time"
            ]
          },
          "properties": {
            "series": {
              "items": {
                "required": [
                  "statistic"
                ]
              }
            }
          }
        }
      ]
    },
    "series": {
      "type": "object",
      "required": [
        "quantity",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "$ref": "#/$defs/token"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "datum": {
          "enum": [
            "MHHW",
            "MHW",
            "MTL",
            "MSL",
            "MLW",
            "MLLW",
            "NAVD88",
            "NGVD29",
            "IGLD85",
            "STND",
            "HAT",
            "LAT",
            "DTL"
          ]
        },
        "sublocation": {
          "$ref": "#/$defs/text",
          "minLength": 1
        },
        "statistic": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "value": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "status": {
          "type": "array",
          "items": {
            "enum": [
              "value",
              "missing",
              "dry"
            ]
          }
        }
      }
    }
  }
}
